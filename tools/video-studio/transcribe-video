#!/usr/bin/env python3
"""
Archivo: tools/video-studio/transcribe-video
Propósito: Transcribe videos o audios largos con faster-whisper + Silero VAD
           activado (--vad-filter por defecto para evitar cortes de frases o
           consumo excesivo de RAM en MP4 largos) y exporta:
           - transcript.json (con tiempos por segmento y por palabra)
           - subtitles.srt
           - subtitles.ass (subtítulos dinámicos palabra por palabra)
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

VENV_DIR = Path(os.environ.get("VIDEO_STUDIO_VENV", "/opt/video-studio-venv"))
VENV_PY = VENV_DIR / "bin" / "python"
if VENV_PY.exists() and Path(sys.prefix).resolve() != VENV_DIR.resolve():
    os.execv(str(VENV_PY), [str(VENV_PY), __file__, *sys.argv[1:]])

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from faster_whisper import WhisperModel  # type: ignore  # noqa: E402
from video_pipeline_lib import build_ass_subtitles_from_words  # noqa: E402


def format_srt_ts(seconds: float) -> str:
    ms_total = max(0, int(round(seconds * 1000)))
    ms = ms_total % 1000
    s_total = ms_total // 1000
    s = s_total % 60
    m_total = s_total // 60
    m = m_total % 60
    h = m_total // 60
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def main() -> int:
    parser = argparse.ArgumentParser(description="Transcripción VAD con marcas por palabra (faster-whisper)")
    parser.add_argument("input", help="Ruta a audio_16k.wav o archivo .mp4/.m4a")
    parser.add_argument("--out-dir", help="Carpeta de salida (por defecto junto al archivo de entrada)")
    parser.add_argument("--model", default="base", help="Modelo faster-whisper (tiny, base, small, medium, large-v3-turbo)")
    parser.add_argument("--language", default=None, help="Código de idioma (ej: es, en). Si se omite, autodetecta")
    parser.add_argument("--compute-type", default="int8", help="Precisión CPU/GPU (int8 recomendado en CPU)")
    parser.add_argument("--vertical", action="store_true", help="Ajusta subtítulos .ass a lienzo vertical 1080x1920")
    parser.add_argument("--no-vad", action="store_true", help="Desactiva Silero VAD (no recomendado en videos largos)")
    args = parser.parse_args()

    in_path = Path(args.input).expanduser().resolve()
    if not in_path.exists():
        print(f"[transcribe] Archivo no encontrado: {in_path}", file=sys.stderr)
        return 1

    out_dir = Path(args.out_dir).resolve() if args.out_dir else in_path.parent
    out_dir.mkdir(parents=True, exist_ok=True)

    cpu_threads = max(1, os.cpu_count() or 4)
    print(f"[transcribe] Cargando faster-whisper ({args.model}, {args.compute_type}, {cpu_threads} hilos)...")
    model = WhisperModel(args.model, device="cpu", compute_type=args.compute_type, cpu_threads=cpu_threads)

    segments_iter, info = model.transcribe(
        str(in_path),
        language=args.language,
        word_timestamps=True,
        vad_filter=not args.no_vad,
        vad_parameters={"min_silence_duration_ms": 450},
    )

    serialized_segments = []
    srt_lines = []
    for idx, seg in enumerate(segments_iter, start=1):
        words = []
        if seg.words:
            for w in seg.words:
                words.append({"word": w.word, "start": round(w.start, 3), "end": round(w.end, 3)})
        serialized_segments.append(
            {
                "id": idx,
                "start": round(seg.start, 3),
                "end": round(seg.end, 3),
                "text": seg.text.strip(),
                "words": words,
            }
        )
        srt_lines.append(f"{idx}\n{format_srt_ts(seg.start)} --> {format_srt_ts(seg.end)}\n{seg.text.strip()}\n")

    transcript_payload = {
        "source": str(in_path),
        "language": info.language,
        "language_probability": round(float(info.language_probability), 4),
        "duration": round(float(info.duration), 3),
        "segments": serialized_segments,
    }

    (out_dir / "transcript.json").write_text(json.dumps(transcript_payload, ensure_ascii=False, indent=2), encoding="utf-8")
    (out_dir / "subtitles.srt").write_text("\n".join(srt_lines), encoding="utf-8")

    res_x, res_y = (1080, 1920) if args.vertical else (1920, 1080)
    margin_v = 340 if args.vertical else 90
    ass_content = build_ass_subtitles_from_words(
        serialized_segments,
        play_res_x=res_x,
        play_res_y=res_y,
        font_size=74 if args.vertical else 58,
        margin_v=margin_v,
    )
    (out_dir / "subtitles.ass").write_text(ass_content, encoding="utf-8")

    print(f"[transcribe] Idioma detectado: {info.language} | Segmentos: {len(serialized_segments)}")
    print(f"             JSON: {out_dir / 'transcript.json'}")
    print(f"             ASS : {out_dir / 'subtitles.ass'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
