#!/usr/bin/env python3
"""
Archivo: tools/video-studio/render-stickman-fight
Propósito: Ejecutable autónomo que renderiza un video animado de 20 segundos
           en HD (1280x720 @ 30fps) con dos stickmen (Azul vs Rojo) peleando
           en un escenario cyber-dojo nocturno con cámara dinámica, sacudida de
           impactos, estelas de movimiento, partículas, barras de vida, textos
           ("ROUND 1", "¡PELEA!", "¡K.O.!") y pista de audio completa con música
           y efectos sincronizados mediante NumPy DSP + FFmpeg.
"""

from __future__ import annotations

import argparse
import math
import os
import subprocess
import sys
import tempfile
import wave
from pathlib import Path
from typing import List, Tuple

VENV_DIR = Path(os.environ.get("VIDEO_STUDIO_VENV", "/opt/video-studio-venv"))
VENV_PY = VENV_DIR / "bin" / "python"
if VENV_PY.exists() and Path(sys.prefix).resolve() != VENV_DIR.resolve():
    os.execv(str(VENV_PY), [str(VENV_PY), __file__, *sys.argv[1:]])

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

import cv2  # type: ignore  # noqa: E402
import numpy as np  # type: ignore  # noqa: E402
from PIL import Image, ImageDraw, ImageFont  # type: ignore  # noqa: E402

from stickman_fight_lib import (  # noqa: E402
    FighterPose,
    ImpactCue,
    build_fight_choreography,
    compute_skeleton_points,
    sample_fight_state,
    synthesize_fight_soundtrack,
)


WIDTH = 1280
HEIGHT = 720
GROUND_Y = 568.0


def load_font(size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    for candidate in (
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-ExtraBold.ttf",
    ):
        if Path(candidate).exists():
            return ImageFont.truetype(candidate, size=size)
    return ImageFont.load_default()


def build_backdrop_base() -> np.ndarray:
    """Pre-renderiza el cielo degradado estático del escenario para acelerar el render."""
    y = np.linspace(0.0, 1.0, HEIGHT, dtype=np.float32)[:, None]
    sky_b = np.clip(72.0 - 44.0 * y + 50.0 * np.exp(-((y - 0.58) ** 2) / 0.05), 18, 120)
    sky_g = np.clip(24.0 + 30.0 * np.exp(-((y - 0.62) ** 2) / 0.04), 16, 80)
    sky_r = np.clip(36.0 + 115.0 * np.exp(-((y - 0.64) ** 2) / 0.035), 22, 165)

    frame = np.zeros((HEIGHT, WIDTH, 3), dtype=np.uint8)
    frame[:, :, 0] = np.broadcast_to(sky_b.astype(np.uint8), (HEIGHT, WIDTH))
    frame[:, :, 1] = np.broadcast_to(sky_g.astype(np.uint8), (HEIGHT, WIDTH))
    frame[:, :, 2] = np.broadcast_to(sky_r.astype(np.uint8), (HEIGHT, WIDTH))

    # Luna/Sol neón gigante al fondo
    cv2.circle(frame, (640, 290), 135, (90, 130, 255), -1, cv2.LINE_AA)
    cv2.circle(frame, (640, 290), 118, (110, 185, 255), -1, cv2.LINE_AA)
    # Líneas horizontales retro sobre el sol
    for band_y in range(250, 425, 18):
        cv2.rectangle(frame, (495, band_y), (785, band_y + 5), (50, 28, 52), -1)

    # Silueta lejana de ciudad cyber
    buildings = [
        (30, 310, 110),
        (115, 255, 185),
        (190, 330, 255),
        (260, 230, 340),
        (350, 295, 425),
        (855, 290, 930),
        (935, 220, 1020),
        (1025, 315, 1105),
        (1110, 245, 1190),
        (1195, 300, 1265),
    ]
    for x1, top, x2 in buildings:
        cv2.rectangle(frame, (x1, top), (x2, int(GROUND_Y)), (36, 22, 28), -1)
        for wx in range(x1 + 12, x2 - 12, 18):
            for wy in range(top + 16, int(GROUND_Y) - 45, 24):
                if (wx * 7 + wy * 13) % 5 != 0:
                    color = (230, 200, 60) if (wx + wy) % 2 == 0 else (70, 175, 255)
                    cv2.rectangle(frame, (wx, wy), (wx + 6, wy + 10), color, -1)

    return frame


def draw_arena_foreground(canvas: np.ndarray, cam_x: float, t: float) -> None:
    """Dibuja pilares del dojo/azotea, baranda y suelo reflectante con paralaje según cámara."""
    parallax_mid = int((640.0 - cam_x) * 0.25)
    parallax_fg = int((640.0 - cam_x) * 0.55)

    # Arco Torii / pórtico central de combate
    cx = 640 + parallax_mid
    cv2.rectangle(canvas, (cx - 210, 205), (cx - 186, int(GROUND_Y)), (32, 24, 48), -1)
    cv2.rectangle(canvas, (cx + 186, 205), (cx + 210, int(GROUND_Y)), (32, 24, 48), -1)
    cv2.rectangle(canvas, (cx - 245, 195), (cx + 245, 220), (45, 32, 85), -1)
    cv2.rectangle(canvas, (cx - 220, 242), (cx + 220, 256), (45, 32, 85), -1)

    # Farolillos brillantes oscilando suavemente
    sway = int(math.sin(t * 2.4) * 5)
    for lx in (cx - 175, cx + 175):
        cv2.line(canvas, (lx, 256), (lx + sway, 284), (160, 170, 200), 2, cv2.LINE_AA)
        cv2.ellipse(canvas, (lx + sway, 300), (14, 19), 0, 0, 360, (60, 150, 255), -1, cv2.LINE_AA)
        cv2.ellipse(canvas, (lx + sway, 300), (9, 13), 0, 0, 360, (180, 235, 255), -1, cv2.LINE_AA)

    # Baranda trasera de la azotea
    rail_y = int(GROUND_Y) - 42
    cv2.line(canvas, (0, rail_y), (WIDTH, rail_y), (88, 72, 115), 4, cv2.LINE_AA)
    for px in range((parallax_fg % 90) - 90, WIDTH + 90, 90):
        cv2.line(canvas, (px, rail_y), (px, int(GROUND_Y)), (75, 62, 100), 4, cv2.LINE_AA)

    # Suelo del escenario con cuadrícula perspectiva neón
    cv2.rectangle(canvas, (0, int(GROUND_Y)), (WIDTH, HEIGHT), (28, 20, 34), -1)
    cv2.line(canvas, (0, int(GROUND_Y)), (WIDTH, int(GROUND_Y)), (220, 195, 110), 4, cv2.LINE_AA)
    for gx in range(-640, 1920, 110):
        top_x = int(640 + (gx - 640) * 0.52 + parallax_fg)
        bot_x = int(640 + (gx - 640) * 1.18 + parallax_fg)
        cv2.line(canvas, (top_x, int(GROUND_Y)), (bot_x, HEIGHT), (72, 46, 95), 2, cv2.LINE_AA)
    for row_off in (24, 58, 104):
        ry = int(GROUND_Y) + row_off
        cv2.line(canvas, (0, ry), (WIDTH, ry), (62, 40, 82), 1, cv2.LINE_AA)


def draw_stickman(
    canvas: np.ndarray,
    glow_layer: np.ndarray,
    pose: FighterPose,
    core_bgr: Tuple[int, int, int],
    glow_bgr: Tuple[int, int, int],
    scarf_trail: List[Tuple[float, float]],
    t: float,
) -> Tuple[float, float]:
    """Dibuja un stickman articulado con sombra, aura, banda/bufanda dinámica y brillo neón."""
    pts = compute_skeleton_points(pose, GROUND_Y, scale=1.08)

    # Sombra en el suelo escalada por altura del salto
    shadow_scale = max(0.35, 1.0 - pose.y / 320.0)
    sx = int(pts["pelvis"][0])
    sy = int(GROUND_Y) + 6
    cv2.ellipse(canvas, (sx, sy), (int(34 * shadow_scale), int(8 * shadow_scale)), 0, 0, 360, (12, 8, 16), -1, cv2.LINE_AA)

    # Aura de combate si está cargando o en ráfaga
    if pose.aura > 0.08:
        aura_r = int(58 + 14 * math.sin(t * 28.0) * pose.aura)
        px, py = int(pts["pelvis"][0]), int(pts["pelvis"][1] - 25)
        cv2.circle(glow_layer, (px, py), aura_r, tuple(int(c * pose.aura * 0.55) for c in glow_bgr), -1, cv2.LINE_AA)

    def to_int(pt: Tuple[float, float]) -> Tuple[int, int]:
        return (int(round(pt[0])), int(round(pt[1])))

    # Bufanda / cinta ninja ondulante desde la nuca
    neck_pt = to_int(pts["neck"])
    scarf_pts = [neck_pt]
    for i, trail_pt in enumerate(scarf_trail):
        wave_y = math.sin(t * 14.0 + i * 1.1) * (3.5 + i * 1.2)
        scarf_pts.append((int(trail_pt[0]), int(trail_pt[1] + wave_y)))
    for i in range(len(scarf_pts) - 1):
        thick = max(2, 7 - i)
        cv2.line(canvas, scarf_pts[i], scarf_pts[i + 1], glow_bgr, thick, cv2.LINE_AA)

    segments = [
        ("pelvis", "knee_b", 8),
        ("knee_b", "foot_b", 7),
        ("shoulder", "elbow_b", 7),
        ("elbow_b", "hand_b", 6),
        ("pelvis", "neck", 10),
        ("pelvis", "knee_f", 9),
        ("knee_f", "foot_f", 8),
        ("shoulder", "elbow_f", 8),
        ("elbow_f", "hand_f", 7),
    ]

    # Trazos neón suaves en glow_layer + núcleo nítido en canvas
    for a, b, thick in segments:
        pa, pb = to_int(pts[a]), to_int(pts[b])
        cv2.line(glow_layer, pa, pb, glow_bgr, thick + 8, cv2.LINE_AA)
        cv2.line(canvas, pa, pb, core_bgr, thick, cv2.LINE_AA)

    # Cabeza + visor brillante
    hc = to_int(pts["head"])
    cv2.circle(glow_layer, hc, 23, glow_bgr, -1, cv2.LINE_AA)
    cv2.circle(canvas, hc, 18, core_bgr, -1, cv2.LINE_AA)
    cv2.circle(canvas, hc, 15, (245, 248, 255), 2, cv2.LINE_AA)
    eye_x = int(hc[0] + pose.facing * 8)
    eye_y = int(hc[1] - 2)
    cv2.line(canvas, (eye_x - int(pose.facing * 4), eye_y), (eye_x + int(pose.facing * 5), eye_y - 2), (255, 255, 255), 3, cv2.LINE_AA)

    # Esfera de energía en la mano si está cargando ataque
    if pose.charge_hand > 0.1:
        hp = to_int(pts["hand_f"])
        cr = int((12 + 12 * math.sin(t * 32.0) * 0.25) * pose.charge_hand)
        cv2.circle(glow_layer, hp, cr + 14, glow_bgr, -1, cv2.LINE_AA)
        cv2.circle(canvas, hp, max(4, cr), (255, 255, 255), -1, cv2.LINE_AA)

    return pts["neck"]


def draw_impacts(canvas: np.ndarray, glow_layer: np.ndarray, impacts: List[ImpactCue], t: float) -> float:
    """Dibuja ondas de choque, chispas y destellos de impacto, devolviendo intensidad de flash."""
    flash_strength = 0.0
    for imp in impacts:
        dt = t - imp.time_sec
        if dt < 0.0 or dt > 0.42:
            continue
        p = dt / 0.42
        cx, cy = int(imp.x), int(imp.y)
        r = int(14 + p * 125 * imp.intensity)
        fade = 1.0 - p
        col = tuple(int(c * fade) for c in imp.color_bgr)
        cv2.circle(glow_layer, (cx, cy), r, col, max(2, int(9 * fade)), cv2.LINE_AA)
        cv2.circle(canvas, (cx, cy), max(4, int(r * 0.55)), (255, 255, 255), max(1, int(4 * fade)), cv2.LINE_AA)

        # Rayos / chispas radiales
        num_sparks = 14 if imp.kind in ("explosion", "ko", "slam") else 8
        for s in range(num_sparks):
            ang = (2.0 * math.pi * s / num_sparks) + imp.time_sec * 3.1
            r0 = 12 + p * 45 * imp.intensity
            r1 = r0 + (34 + (s % 3) * 18) * imp.intensity
            p0 = (int(cx + math.cos(ang) * r0), int(cy + math.sin(ang) * r0))
            p1 = (int(cx + math.cos(ang) * r1), int(cy + math.sin(ang) * r1))
            cv2.line(canvas, p0, p1, col, max(2, int(4 * fade)), cv2.LINE_AA)

        if dt < 0.08 and imp.intensity >= 1.2:
            flash_strength = max(flash_strength, (1.0 - dt / 0.08) * 0.24)

    return flash_strength


def overlay_arcade_hud(
    frame_bgr: np.ndarray,
    t: float,
    blue_hp: float,
    red_hp: float,
    font_sm: ImageFont.FreeTypeFont | ImageFont.ImageFont,
    font_big: ImageFont.FreeTypeFont | ImageFont.ImageFont,
) -> np.ndarray:
    """Superpone barras de salud estilo arcade y carteles animados de combate."""
    img_rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
    pil_img = Image.fromarray(img_rgb)
    draw = ImageDraw.Draw(pil_img, "RGBA")

    # Barra de vida Azul (izquierda) y Roja (derecha)
    bar_w = 430
    bar_h = 24
    y0 = 36

    # Fondo semitransparente HUD
    draw.rounded_rectangle((46, y0 - 8, 46 + bar_w + 16, y0 + bar_h + 26), radius=10, fill=(10, 12, 22, 180))
    draw.rounded_rectangle((WIDTH - 46 - bar_w - 16, y0 - 8, WIDTH - 46, y0 + bar_h + 26), radius=10, fill=(10, 12, 22, 180))

    # Vida Azul (se vacía hacia el centro)
    draw.rounded_rectangle((54, y0, 54 + bar_w, y0 + bar_h), radius=6, fill=(32, 40, 62, 255))
    fill_b = int(bar_w * max(0.0, min(1.0, blue_hp)))
    if fill_b > 4:
        draw.rounded_rectangle((54 + (bar_w - fill_b), y0, 54 + bar_w, y0 + bar_h), radius=6, fill=(38, 175, 255, 255))
    draw.text((56, y0 + bar_h + 3), "STICKMAN AZUL", font=font_sm, fill=(130, 220, 255, 255))

    # Vida Roja
    rx0 = WIDTH - 54 - bar_w
    draw.rounded_rectangle((rx0, y0, rx0 + bar_w, y0 + bar_h), radius=6, fill=(52, 26, 36, 255))
    fill_r = int(bar_w * max(0.0, min(1.0, red_hp)))
    if fill_r > 4:
        draw.rounded_rectangle((rx0, y0, rx0 + fill_r, y0 + bar_h), radius=6, fill=(255, 65, 85, 255))
    red_bbox = draw.textbbox((0, 0), "STICKMAN ROJO", font=font_sm)
    red_tw = red_bbox[2] - red_bbox[0]
    draw.text((rx0 + bar_w - red_tw - 2, y0 + bar_h + 3), "STICKMAN ROJO", font=font_sm, fill=(255, 145, 155, 255))

    # Temporizador central VS
    rem = max(0, int(math.ceil(20.0 - t)))
    draw.rounded_rectangle((592, 26, 688, 76), radius=12, fill=(14, 16, 28, 220), outline=(255, 210, 90, 220), width=2)
    draw.text((621 if rem >= 10 else 631, 35), f"{rem:02d}", font=font_sm, fill=(255, 232, 130, 255))

    # Anuncios dinámicos de combate
    banner = None
    banner_color = (255, 230, 90, 255)
    if 0.65 <= t <= 1.25:
        banner = "ROUND 1"
    elif 1.28 <= t <= 1.90:
        banner = "¡PELEA!"
        banner_color = (100, 235, 255, 255)
    elif 9.45 <= t <= 10.40:
        banner = "¡CHOQUE!"
        banner_color = (255, 190, 75, 255)
    elif 17.45 <= t <= 19.85:
        banner = "¡K.O.! AZUL GANA"
        banner_color = (90, 230, 255, 255)

    if banner:
        bbox = draw.textbbox((0, 0), banner, font=font_big)
        tw = bbox[2] - bbox[0]
        th = bbox[3] - bbox[1]
        tx = (WIDTH - tw) // 2
        ty = 158
        draw.text((tx + 4, ty + 4), banner, font=font_big, fill=(0, 0, 0, 210))
        draw.text((tx, ty), banner, font=font_big, fill=banner_color)

    return cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2BGR)


def main() -> int:
    parser = argparse.ArgumentParser(description="Genera un video animado de combate stickman Azul vs Rojo con audio")
    parser.add_argument("--duration", type=float, default=20.0, help="Duración total en segundos (por defecto: 20)")
    parser.add_argument("--fps", type=int, default=30, help="Fotogramas por segundo (por defecto: 30)")
    parser.add_argument(
        "--out",
        default=str(SCRIPT_DIR / "workspace" / "exports" / "stickman_fight_20s.mp4"),
        help="Ruta de salida del archivo .mp4",
    )
    args = parser.parse_args()

    out_path = Path(args.out).expanduser().resolve()
    out_path.parent.mkdir(parents=True, exist_ok=True)

    duration = float(args.duration)
    fps = int(args.fps)
    total_frames = int(round(duration * fps))

    blue_keys, red_keys, hp_keys, impacts, sounds = build_fight_choreography()
    base_sky = build_backdrop_base()
    font_sm = load_font(18)
    font_big = load_font(66)

    print(f"[stickman] Generando audio estéreo 48 kHz ({duration:.1f}s)...")
    pcm = synthesize_fight_soundtrack(duration, sounds, sr=48000)

    with tempfile.TemporaryDirectory(prefix="bf_stickman_") as tmp:
        wav_path = Path(tmp) / "fight_audio.wav"
        with wave.open(str(wav_path), "wb") as wf:
            wf.setnchannels(2)
            wf.setsampwidth(2)
            wf.setframerate(48000)
            wf.writeframes(pcm.tobytes())

        ffmpeg_cmd = [
            "ffmpeg",
            "-y",
            "-hide_banner",
            "-loglevel",
            "error",
            "-f",
            "rawvideo",
            "-vcodec",
            "rawvideo",
            "-pix_fmt",
            "bgr24",
            "-s",
            f"{WIDTH}x{HEIGHT}",
            "-r",
            str(fps),
            "-i",
            "-",
            "-i",
            str(wav_path),
            "-c:v",
            "libx264",
            "-preset",
            "medium",
            "-crf",
            "18",
            "-pix_fmt",
            "yuv420p",
            "-c:a",
            "aac",
            "-b:a",
            "192k",
            "-shortest",
            "-movflags",
            "+faststart",
            str(out_path),
        ]

        print(f"[stickman] Renderizando {total_frames} fotogramas ({WIDTH}x{HEIGHT} @ {fps}fps) -> {out_path.name}")
        proc = subprocess.Popen(ffmpeg_cmd, stdin=subprocess.PIPE)
        assert proc.stdin is not None

        blue_trail: List[Tuple[float, float]] = [(310.0, 220.0)] * 5
        red_trail: List[Tuple[float, float]] = [(970.0, 220.0)] * 5

        for frame_idx in range(total_frames):
            t = frame_idx / float(fps)
            blue_pose, red_pose, blue_hp, red_hp = sample_fight_state(t, blue_keys, red_keys, hp_keys)
            cam_x = 0.5 * (blue_pose.x + red_pose.x)

            # Shake de cámara calculado por cercanía a impactos fuertes
            shake_x = 0.0
            shake_y = 0.0
            for imp in impacts:
                dt = t - imp.time_sec
                if 0.0 <= dt < 0.25:
                    amp = 16.0 * imp.intensity * (1.0 - dt / 0.25)
                    shake_x += math.sin(frame_idx * 2.7 + imp.time_sec * 10.0) * amp
                    shake_y += math.cos(frame_idx * 3.3 + imp.time_sec * 7.0) * amp

            canvas = base_sky.copy()
            glow_layer = np.zeros_like(canvas)

            draw_arena_foreground(canvas, cam_x, t)

            # Líneas de velocidad cinemáticas durante choques clave
            if (8.9 <= t <= 10.9) or (14.9 <= t <= 16.2):
                for ly in range(110, int(GROUND_Y), 38):
                    lx_start = (frame_idx * 47 + ly * 13) % WIDTH
                    cv2.line(canvas, (lx_start, ly), (lx_start + 130, ly), (140, 120, 190), 1, cv2.LINE_AA)

            # Dibujar ambos stickmen (Azul: cian brillante; Rojo: carmesí brillante)
            b_neck = draw_stickman(
                canvas,
                glow_layer,
                blue_pose,
                core_bgr=(255, 195, 45),
                glow_bgr=(255, 140, 20),
                scarf_trail=blue_trail,
                t=t,
            )
            r_neck = draw_stickman(
                canvas,
                glow_layer,
                red_pose,
                core_bgr=(70, 75, 255),
                glow_bgr=(40, 45, 230),
                scarf_trail=red_trail,
                t=t,
            )

            # Actualizar estela física de la bufanda
            blue_trail = [(b_neck[0] - blue_pose.facing * 12, b_neck[1] + 2)] + [
                (px - blue_pose.facing * 8, py + 1.5) for px, py in blue_trail[:-1]
            ]
            red_trail = [(r_neck[0] - red_pose.facing * 12, r_neck[1] + 2)] + [
                (px - red_pose.facing * 8, py + 1.5) for px, py in red_trail[:-1]
            ]

            flash = draw_impacts(canvas, glow_layer, impacts, t)

            # Difuminado gaussiano al layer de brillo neón + suma aditiva
            glow_blur = cv2.GaussianBlur(glow_layer, (0, 0), sigmaX=10, sigmaY=10)
            composited = cv2.addWeighted(canvas, 1.0, glow_blur, 0.85, 0)

            # Aplicar sacudida de cámara y zoom leve en impactos fuertes
            if abs(shake_x) > 0.2 or abs(shake_y) > 0.2:
                mat = np.float32([[1, 0, shake_x], [0, 1, shake_y]])
                composited = cv2.warpAffine(composited, mat, (WIDTH, HEIGHT), borderMode=cv2.BORDER_REPLICATE)

            if flash > 0.01:
                white = np.full_like(composited, 255)
                composited = cv2.addWeighted(composited, 1.0 - flash, white, flash, 0)

            composited = overlay_arcade_hud(composited, t, blue_hp, red_hp, font_sm, font_big)
            proc.stdin.write(composited.tobytes())

        proc.stdin.close()
        ret = proc.wait()
        if ret != 0:
            print(f"[stickman] FFmpeg terminó con error {ret}", file=sys.stderr)
            return ret

    size_mb = out_path.stat().st_size / (1024 * 1024)
    print(f"[stickman] Video listo: {out_path} ({size_mb:.2f} MB)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
