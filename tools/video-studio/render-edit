#!/usr/bin/env python3
"""
Archivo: tools/video-studio/render-edit
Propósito: Motor de renderizado determinista que lee un plan JSON (edit.json)
           y ensambla el .mp4 final mediante FFmpeg en streaming seguro para
           videos largos:
           - Modo `--mode copy`: cortes rápidos sin recodificar (ideal para
             partir/recortar archivos .mp4 enormes en segundos)
           - Modo `--mode draft`: vista previa rápida 480p
           - Modo `--mode master`: salida final 1080p/vertical con loudnorm
             (-14 LUFS), música de fondo opcional y quemado de subtítulos .ass
           - Opción `--qc`: extrae fotogramas clave para inspección visual
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from video_pipeline_lib import compute_target_dimensions  # noqa: E402


def probe_dimensions(video_path: Path) -> tuple[int, int, float]:
    proc = subprocess.run(
        [
            "ffprobe",
            "-v",
            "quiet",
            "-print_format",
            "json",
            "-show_streams",
            "-show_format",
            str(video_path),
        ],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    data = json.loads(proc.stdout)
    duration = float(data.get("format", {}).get("duration", 0.0))
    for st in data.get("streams", []):
        if st.get("codec_type") == "video":
            return int(st.get("width", 1920)), int(st.get("height", 1080)), duration
    return 1920, 1080, duration


def escape_ffmpeg_filter_path(path: Path) -> str:
    return str(path).replace("\\", "\\\\").replace(":", "\\:").replace("'", "\\'")


def render_copy_segments(source: Path, segments: list[dict], out_path: Path) -> None:
    """Corta y une segmentos sin recodificar (keyframe-aligned, ultrarrápido en MP4 gigantes)."""
    with tempfile.TemporaryDirectory(prefix="bf_copy_") as tmp:
        tmp_dir = Path(tmp)
        concat_lines = []
        for idx, seg in enumerate(segments):
            part = tmp_dir / f"part_{idx:04d}.mp4"
            s = float(seg["start"])
            dur = max(0.05, float(seg["end"]) - s)
            subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-hide_banner",
                    "-loglevel",
                    "error",
                    "-ss",
                    f"{s:.3f}",
                    "-i",
                    str(source),
                    "-t",
                    f"{dur:.3f}",
                    "-c",
                    "copy",
                    "-avoid_negative_ts",
                    "make_zero",
                    str(part),
                ],
                check=True,
            )
            concat_lines.append(f"file '{part.as_posix()}'")
        concat_file = tmp_dir / "concat.txt"
        concat_file.write_text("\n".join(concat_lines) + "\n", encoding="utf-8")
        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-hide_banner",
                "-loglevel",
                "error",
                "-f",
                "concat",
                "-safe",
                "0",
                "-i",
                str(concat_file),
                "-c",
                "copy",
                str(out_path),
            ],
            check=True,
        )


def render_reencoded(plan: dict, source: Path, out_path: Path, mode: str) -> None:
    """Renderizado preciso (frame-accurate) con reencuadre, loudnorm, BGM y subtítulos."""
    segments = plan["segments"]
    aspect = plan.get("aspect", "preserve")
    src_w, src_h, _ = probe_dimensions(source)
    target_w, target_h = compute_target_dimensions(aspect, src_w, src_h)
    if mode == "draft":
        scale_factor = 480.0 / max(1, min(target_w, target_h))
        if scale_factor < 1.0:
            target_w = max(2, int(target_w * scale_factor) // 2 * 2)
            target_h = max(2, int(target_h * scale_factor) // 2 * 2)

    with tempfile.TemporaryDirectory(prefix="bf_render_") as tmp:
        tmp_dir = Path(tmp)
        concat_lines = []

        # Recorta primero cada segmento con libx264 ultrafast para evitar grafos gigantes en MP4 largos
        for idx, seg in enumerate(segments):
            part = tmp_dir / f"seg_{idx:04d}.mp4"
            s = float(seg["start"])
            dur = max(0.05, float(seg["end"]) - s)
            vf_crop = ""
            if aspect != "preserve":
                vf_crop = (
                    f"scale={target_w}:{target_h}:force_original_aspect_ratio=increase,"
                    f"crop={target_w}:{target_h},"
                )
            elif mode == "draft":
                vf_crop = f"scale={target_w}:{target_h},"

            vf = f"{vf_crop}setsar=1"
            subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-hide_banner",
                    "-loglevel",
                    "error",
                    "-ss",
                    f"{s:.3f}",
                    "-i",
                    str(source),
                    "-t",
                    f"{dur:.3f}",
                    "-vf",
                    vf,
                    "-c:v",
                    "libx264",
                    "-preset",
                    "ultrafast" if mode == "draft" else "veryfast",
                    "-crf",
                    "26" if mode == "draft" else "18",
                    "-c:a",
                    "aac",
                    "-b:a",
                    "192k",
                    "-ar",
                    "48000",
                    "-ac",
                    "2",
                    str(part),
                ],
                check=True,
            )
            concat_lines.append(f"file '{part.as_posix()}'")

        stitched = tmp_dir / "stitched.mp4"
        concat_file = tmp_dir / "concat.txt"
        concat_file.write_text("\n".join(concat_lines) + "\n", encoding="utf-8")
        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-hide_banner",
                "-loglevel",
                "error",
                "-f",
                "concat",
                "-safe",
                "0",
                "-i",
                str(concat_file),
                "-c",
                "copy",
                str(stitched),
            ],
            check=True,
        )

        # Pase final maestro: subtítulos + loudnorm (-14 LUFS) + música de fondo si existe
        subs_raw = plan.get("subtitles")
        subs_path = Path(subs_raw).expanduser().resolve() if subs_raw else None
        bgm_cfg = plan.get("bgm")
        bgm_path = Path(bgm_cfg["path"]).expanduser().resolve() if bgm_cfg and bgm_cfg.get("path") else None
        norm_lufs = plan.get("normalize_audio_lufs")

        needs_final_pass = bool((subs_path and subs_path.exists()) or (bgm_path and bgm_path.exists()) or norm_lufs)
        if not needs_final_pass:
            stitched.replace(out_path)
            return

        cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-i", str(stitched)]
        filter_parts = []
        v_map = "0:v"
        a_map = "0:a"

        if subs_path and subs_path.exists():
            esc_sub = escape_ffmpeg_filter_path(subs_path)
            filter_name = "ass" if subs_path.suffix.lower() == ".ass" else "subtitles"
            filter_parts.append(f"[0:v]{filter_name}='{esc_sub}'[vout]")
            v_map = "[vout]"

        if norm_lufs:
            filter_parts.append(f"[0:a]loudnorm=I={float(norm_lufs)}:TP=-1.5:LRA=11[amain]")
            a_src = "[amain]"
        else:
            a_src = "[0:a]"

        if bgm_path and bgm_path.exists():
            vol = float(bgm_cfg.get("volume", 0.12))
            cmd.extend(["-stream_loop", "-1", "-i", str(bgm_path)])
            filter_parts.append(f"[1:a]volume={vol:.3f}[abgm]")
            filter_parts.append(f"{a_src}[abgm]amix=inputs=2:duration=first:dropout_transition=2[aout]")
            a_map = "[aout]"
        elif norm_lufs:
            a_map = "[amain]"

        if filter_parts:
            cmd.extend(["-filter_complex", ";".join(filter_parts)])
        cmd.extend(["-map", v_map, "-map", a_map])
        if v_map == "0:v":
            cmd.extend(["-c:v", "copy"])
        else:
            cmd.extend(
                [
                    "-c:v",
                    "libx264",
                    "-preset",
                    "veryfast" if mode == "draft" else "medium",
                    "-crf",
                    "26" if mode == "draft" else "19",
                    "-pix_fmt",
                    "yuv420p",
                ]
            )
        cmd.extend(["-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(out_path)])
        subprocess.run(cmd, check=True)


def extract_qc_frames(out_path: Path, count: int = 4) -> list[Path]:
    _, _, duration = probe_dimensions(out_path)
    qc_dir = out_path.parent / f"{out_path.stem}_qc"
    qc_dir.mkdir(parents=True, exist_ok=True)
    frames = []
    if duration <= 0:
        return frames
    for idx in range(count):
        ts = duration * (idx + 0.5) / count
        frame_file = qc_dir / f"frame_{idx + 1:02d}.png"
        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-hide_banner",
                "-loglevel",
                "error",
                "-ss",
                f"{ts:.2f}",
                "-i",
                str(out_path),
                "-frames:v",
                "1",
                str(frame_file),
            ],
            check=True,
        )
        frames.append(frame_file)
    return frames


def main() -> int:
    parser = argparse.ArgumentParser(description="Renderizador modular por edit.json con FFmpeg")
    parser.add_argument("edit_json", help="Ruta al archivo edit.json generado o editado")
    parser.add_argument("--out", help="Ruta de salida .mp4")
    parser.add_argument("--mode", default="master", choices=["copy", "draft", "master"])
    parser.add_argument("--qc", action="store_true", help="Extrae fotogramas PNG de verificación tras renderizar")
    args = parser.parse_args()

    edit_path = Path(args.edit_json).expanduser().resolve()
    if not edit_path.exists():
        print(f"[render] No existe el plan JSON: {edit_path}", file=sys.stderr)
        return 1

    plan = json.loads(edit_path.read_text(encoding="utf-8"))
    source = Path(plan["source"]).expanduser().resolve()
    if not source.exists():
        print(f"[render] No existe el video fuente: {source}", file=sys.stderr)
        return 1

    out_path = (
        Path(args.out).expanduser().resolve()
        if args.out
        else SCRIPT_DIR / "workspace" / "exports" / f"{edit_path.stem}_{args.mode}.mp4"
    )
    out_path.parent.mkdir(parents=True, exist_ok=True)

    print(f"[render] Modo={args.mode} | Segmentos={len(plan['segments'])} | Salida={out_path.name}")
    if args.mode == "copy":
        render_copy_segments(source, plan["segments"], out_path)
    else:
        render_reencoded(plan, source, out_path, args.mode)

    print(f"[render] Listo: {out_path} ({out_path.stat().st_size / (1024 * 1024):.2f} MB)")
    if args.qc:
        frames = extract_qc_frames(out_path)
        print(f"[render] Fotogramas QC guardados: {[f.name for f in frames]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
