<?xml version="1.0" encoding="utf-8"?>
<!--
  Archivo: android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
  Propósito: Adaptive Icon estándar (Android 8.0+ / API 26+). Permite que cualquier
  launcher adapte el logo "Beat Hammer" a círculo, squircle, gota o cuadrado redondeado
